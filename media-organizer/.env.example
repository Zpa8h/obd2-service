# Media Library Organizer Configuration

# Path to the directory containing your media files to organize
MEDIA_SOURCE_DIR=/path/to/your/media

# Path to the base destination directory (subfolders will be created automatically)
MEDIA_DEST_DIR=/path/to/organized/output

# Flask settings
SECRET_KEY=change-this-to-a-random-string
FLASK_DEBUG=false
PORT=5000
LOG_LEVEL=INFO

# Database path (defaults to media_organizer.db in the working directory)
MEDIA_ORGANIZER_DB=media_organizer.db

# Directory for undo log files
UNDO_LOG_DIR=undo_logs
