# OBD2 Data Pipeline Service - Environment Variables Configuration
# Copy this file to .env and update with your actual values

# ===========================
# Database Configuration
# ===========================

# For MariaDB/MySQL on external server:
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/obd2_db

# For SQLite (testing only):
# DATABASE_URL=sqlite:///./obd2_test.db

# Enable SQL query logging (True/False)
DATABASE_ECHO=False

# ===========================
# MariaDB Docker Configuration
# (Only needed if using docker-compose with MariaDB container)
# ===========================

MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=obd2_db
MYSQL_USER=obd2user
MYSQL_PASSWORD=obd2password

# ===========================
# Application Configuration
# ===========================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# CSV uploads folder path
CSV_UPLOADS_FOLDER=/data/csv_uploads

# CSV processed folder path
CSV_PROCESSED_FOLDER=/data/csv_uploads/processed

# Maximum CSV file size (MB)
MAX_FILE_SIZE_MB=50

# ===========================
# Docker Volume Mounts
# (Only needed if using docker-compose)
# ===========================

# Host path for CSV uploads folder
HOST_CSV_UPLOADS_FOLDER=./data/csv_uploads

# Host path for processed CSVs folder
HOST_CSV_PROCESSED_FOLDER=./data/csv_uploads/processed
